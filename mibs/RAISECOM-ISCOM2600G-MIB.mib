-- RAISECOM-ISCOM2600G-MIB
--
-- Generated by mibs/gen_mibs.py; edit the generator, not this file.
-- Unofficial MIB for Raisecom ISCOM2600G switches, written from what
-- an ISCOM2624G-4GE-PWR-AC with software 3.60.311 (ROS 5.2.1) actually returns. Objects marked
-- "Reconstructed" have no published Raisecom MIB.
--

RAISECOM-ISCOM2600G-MIB DEFINITIONS ::= BEGIN

IMPORTS
    Gauge32,
    Integer32,
    MODULE-IDENTITY,
    OBJECT-TYPE,
    TimeTicks,
    Unsigned32,
    enterprises
        FROM SNMPv2-SMI
    DisplayString,
    MacAddress,
    TEXTUAL-CONVENTION
        FROM SNMPv2-TC;

raisecom MODULE-IDENTITY
    LAST-UPDATED "202610210000Z"
    ORGANIZATION "raisecom-snmp-exporter project (unofficial, not a Raisecom publication)"
    CONTACT-INFO
        "See README.md in the raisecom-snmp-exporter repository."
    DESCRIPTION
        "Self-contained MIB with every private object the
         raisecom_exporter reads from Raisecom ISCOM2600G switches:
         device identification, port descriptions, PoE measurements, CPU,
         memory, temperature, fans and optical transceivers with DDM. It
         imports only SNMPv2-SMI, SNMPv2-TC and SNMPv2-CONF. The same
         objects are available split into conventional modules in
         mibs/modules."
    REVISION     "202610210000Z"
    DESCRIPTION
        "Initial version."
    ::= { enterprises 8886 }

EnableVar ::= TEXTUAL-CONVENTION
    STATUS      current
    DESCRIPTION
        "Enable or disable a function."
    SYNTAX      INTEGER { enable(1), disable(2) }

OpticalParameterType ::= TEXTUAL-CONVENTION
    STATUS      current
    DESCRIPTION
        "Monitored DDM parameter. The published Raisecom MIB names value
         5 laserTemperature; software 3.60.311 (ROS 5.2.1) returns the
         3.3 V supply voltage there (about 3300 mV with 2900..3600 mV
         thresholds)."
    SYNTAX      INTEGER { transceiverTemperature(1), txBiasCurrent(2), txPower(3), rxPower(4), supplyVoltage(5) }

OpticalParameterValue ::= TEXTUAL-CONVENTION
    DISPLAY-HINT "d-3"
    STATUS      current
    DESCRIPTION
        "DDM value in thousandths of the base unit:
         transceiverTemperature in millidegrees Celsius, txBiasCurrent in
         microamperes, txPower and rxPower in thousandths of dBm,
         supplyVoltage in millivolts. -1000000 means not available."
    SYNTAX      Integer32 (-1000000 | -40000..6553600)

raisecomAgent OBJECT IDENTIFIER ::= { raisecom 1 }

iscomSeries OBJECT IDENTIFIER ::= { raisecom 6 }

iscomSwitch OBJECT IDENTIFIER ::= { iscomSeries 1 }

