raisecomOpticalTransceiverDDMGroup OBJECT IDENTIFIER ::= { raisecomOpticalTransceiverObjects 2 }

raisecomOpticalTransceiverDDMTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF RaisecomOpticalTransceiverDDMEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Digital diagnostics of each transceiver parameter. Rows of
         modules without DDM support contain zeros."
    ::= { raisecomOpticalTransceiverDDMGroup 1 }

raisecomOpticalTransceiverDDMEntry OBJECT-TYPE
    SYNTAX      RaisecomOpticalTransceiverDDMEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One monitored parameter of one transceiver."
    INDEX       { raisecomOpticalTransceiverDDMIfIndex, raisecomOpticalTransceiverParameterType }
    ::= { raisecomOpticalTransceiverDDMTable 1 }

RaisecomOpticalTransceiverDDMEntry ::= SEQUENCE {
    raisecomOpticalTransceiverParameterType           OpticalParameterType,
    raisecomOpticalTransceiverParameterValue          OpticalParameterValue,
    raisecomOpticalTransceiverParamHighAlarmThresh    OpticalParameterValue,
    raisecomOpticalTransceiverParamHighWarningThresh  OpticalParameterValue,
    raisecomOpticalTransceiverParamLowAlarmThresh     OpticalParameterValue,
    raisecomOpticalTransceiverParamLowWarningThresh   OpticalParameterValue,
    raisecomOpticalTransceiverParamAlarmStatus        INTEGER,
    raisecomOpticalTransceiverParamAlarmLastValue     OpticalParameterValue,
    raisecomOpticalTransceiverParamAlarmLastChange    TimeTicks,
    raisecomOpticalTransceiverDDM15MinValidIntervals  Unsigned32,
    raisecomOpticalTransceiverDDM24HrValidIntervals   Unsigned32,
    raisecomOpticalTransceiverDDMValidStatus          INTEGER,
    raisecomOpticalTransceiverDDMIfIndex              Integer32
}

raisecomOpticalTransceiverDDMIfIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "ifIndex of the port (IF-MIB ifIndex). Defined locally to keep
         this module self-contained."
    ::= { raisecomOpticalTransceiverDDMEntry 100 }

raisecomOpticalTransceiverParameterType OBJECT-TYPE
    SYNTAX      OpticalParameterType
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Monitored parameter."
    ::= { raisecomOpticalTransceiverDDMEntry 1 }

raisecomOpticalTransceiverParameterValue OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Current value."
    ::= { raisecomOpticalTransceiverDDMEntry 2 }

raisecomOpticalTransceiverParamHighAlarmThresh OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "High alarm threshold."
    ::= { raisecomOpticalTransceiverDDMEntry 3 }

raisecomOpticalTransceiverParamHighWarningThresh OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "High warning threshold."
    ::= { raisecomOpticalTransceiverDDMEntry 4 }

raisecomOpticalTransceiverParamLowAlarmThresh OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Low alarm threshold."
    ::= { raisecomOpticalTransceiverDDMEntry 5 }

raisecomOpticalTransceiverParamLowWarningThresh OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Low warning threshold."
    ::= { raisecomOpticalTransceiverDDMEntry 6 }

raisecomOpticalTransceiverParamAlarmStatus OBJECT-TYPE
    SYNTAX      INTEGER { unknown(0), normal(1), highAlarm(2), highWarning(3), lowAlarm(4), lowWarning(5) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Current threshold state."
    ::= { raisecomOpticalTransceiverDDMEntry 7 }

raisecomOpticalTransceiverParamAlarmLastValue OBJECT-TYPE
    SYNTAX      OpticalParameterValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Value when the last alarm was raised."
    ::= { raisecomOpticalTransceiverDDMEntry 8 }

raisecomOpticalTransceiverParamAlarmLastChange OBJECT-TYPE
    SYNTAX      TimeTicks
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "sysUpTime when the alarm status last changed."
    ::= { raisecomOpticalTransceiverDDMEntry 9 }

raisecomOpticalTransceiverDDM15MinValidIntervals OBJECT-TYPE
    SYNTAX      Unsigned32 (0..96)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Number of valid 15-minute history intervals."
    ::= { raisecomOpticalTransceiverDDMEntry 10 }

raisecomOpticalTransceiverDDM24HrValidIntervals OBJECT-TYPE
    SYNTAX      Unsigned32 (0..7)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Number of valid 24-hour history intervals."
    ::= { raisecomOpticalTransceiverDDMEntry 11 }

raisecomOpticalTransceiverDDMValidStatus OBJECT-TYPE
    SYNTAX      INTEGER { unknown(0), valid(1), invalid(2) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Whether the current value is valid."
    ::= { raisecomOpticalTransceiverDDMEntry 12 }

-- Objects of RAISECOM-DEVICE-MIB

raisecomDeviceMIB OBJECT IDENTIFIER ::= { iscomSwitch 1 }

raisecomDeviceInfo OBJECT IDENTIFIER ::= { raisecomDeviceMIB 1 }

raisecomDeviceSoftwareVersion OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Software version, e.g. 3.60.311(Compiled Mar 25 2020 18:40:44).
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomDeviceInfo 1 }

raisecomDeviceHardwareVersion OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Hardware version, e.g. A.01. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 2 }

raisecomDevicePortNumber OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Number of interfaces (equals ifNumber on the reference device).
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomDeviceInfo 5 }

raisecomDeviceMacAddress OBJECT-TYPE
    SYNTAX      MacAddress
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "System MAC address. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 9 }

raisecomDeviceBootromVersion OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Bootrom version. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 13 }

raisecomDeviceSerialNumber OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Serial number. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 14 }

raisecomDeviceDescription OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Model and software version, e.g. ISCOM2624G-4GE-PWR-AC 3.60.311.
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomDeviceInfo 16 }

raisecomDeviceVendor OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Vendor short name. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 17 }

raisecomDeviceManufacturer OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Manufacturer full name. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomDeviceInfo 18 }

raisecomDeviceModelName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Model name, e.g. ISCOM2624G-4GE-PWR-AC. Reconstructed from data
         returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomDeviceInfo 19 }

-- Objects of RAISECOM-PORT-MIB

raisecomPortMIB OBJECT IDENTIFIER ::= { iscomSwitch 20 }

raisecomPortObjects OBJECT IDENTIFIER ::= { raisecomPortMIB 1 }

raisecomPortTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF RaisecomPortEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Per-port settings."
    ::= { raisecomPortObjects 1 }

raisecomPortEntry OBJECT-TYPE
    SYNTAX      RaisecomPortEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Settings of one port."
    INDEX       { raisecomPortIfIndex }
    ::= { raisecomPortTable 1 }

RaisecomPortEntry ::= SEQUENCE {
    raisecomPortDescription  DisplayString,
    raisecomPortIfIndex      Integer32
}

raisecomPortIfIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "ifIndex of the port (IF-MIB ifIndex). Defined locally to keep
         this module self-contained."
    ::= { raisecomPortEntry 100 }

raisecomPortDescription OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Description configured on the port (ROS leaves IF-MIB ifAlias
         empty). Reconstructed from data returned by ISCOM2624G-4GE-PWR-
         AC, software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPortEntry 2 }

-- Objects of RAISECOM-POE-MIB

raisecomPoeMIB OBJECT IDENTIFIER ::= { iscomSwitch 51 }

raisecomPoePortTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF RaisecomPoePortEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Per-port PoE measurements."
    ::= { raisecomPoeMIB 1 }

raisecomPoePortEntry OBJECT-TYPE
    SYNTAX      RaisecomPoePortEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "PoE measurements of one port, indexed like pethPsePortTable (PSE
         group, port ifIndex)."
    INDEX       { raisecomPoePortGroupIndex, raisecomPoePortIfIndex }
    ::= { raisecomPoePortTable 1 }

RaisecomPoePortEntry ::= SEQUENCE {
    raisecomPoePortPeakPower        Gauge32,
    raisecomPoePortPower            Gauge32,
    raisecomPoePortPowerInstant     Gauge32,
    raisecomPoePortVoltage          Gauge32,
    raisecomPoePortCurrent          Gauge32,
    raisecomPoePortPowerLimit       Gauge32,
    raisecomPoePortAdminStatus      EnableVar,
    raisecomPoePortForcePower       EnableVar,
    raisecomPoePortScheduleProfile  Integer32,
    raisecomPoePortAliveCheck       EnableVar,
    raisecomPoePortAliveAction      INTEGER,
    raisecomPoePortRebootInterval   Integer32,
    raisecomPoePortLinktraceTrack   Integer32,
    raisecomPoePortOperStatus       EnableVar,
    raisecomPoePortGroupIndex       Integer32,
    raisecomPoePortIfIndex          Integer32
}

raisecomPoePortIfIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "ifIndex of the port (IF-MIB ifIndex). Defined locally to keep
         this module self-contained."
    ::= { raisecomPoePortEntry 101 }

raisecomPoePortGroupIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "PSE group, always 1 on single-PSE switches. Matches
         pethPsePortGroupIndex."
    ::= { raisecomPoePortEntry 100 }

raisecomPoePortPeakPower OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Highest power drawn on the port. Reconstructed from data
         returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 1 }

raisecomPoePortPower OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Power drawn by the powered device, smoothed (moving average of
         raisecomPoePortPowerInstant). Reconstructed from data returned
         by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1);
         Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 2 }

raisecomPoePortPowerInstant OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Latest power sample, 100 mW resolution; this is the 'Output
         Power(mW)' column of CLI 'show poe interface'. Reconstructed
         from data returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311
         (ROS 5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 3 }

raisecomPoePortVoltage OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "millivolts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Output voltage ('Output Voltage(mV)' in CLI). Reconstructed from
         data returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 4 }

raisecomPoePortCurrent OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliamperes"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Output current ('Output Current(mA)' in CLI). Reconstructed from
         data returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 5 }

raisecomPoePortPowerLimit OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Maximum power the port may deliver ('Max Power(mW)' in CLI, set
         with 'poe max-power'). Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomPoePortEntry 6 }

raisecomPoePortAdminStatus OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Administrative PoE state of the port (CLI 'poe enable|disable',
         shown as 'POE administrator status'). 'poe disable' changes this
         column together with raisecomPoePortOperStatus and
         pethPsePortAdminEnable; it is taken as the administrative one
         because columns 7..14 all hold port settings. Reconstructed from
         data returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 7 }

raisecomPoePortForcePower OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Force power without PD detection (CLI 'poe force-power', shown
         as 'POE force-power status'). Reconstructed from data returned
         by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1);
         Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 8 }

raisecomPoePortScheduleProfile OBJECT-TYPE
    SYNTAX      Integer32 (0..2147483647)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "PoE schedule profile bound to the port, 0 for none (CLI 'poe
         schedule profile', shown as 'POE schedule profile'). Inferred
         from the column position and the CLI field order; not verified.
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPoePortEntry 9 }

raisecomPoePortAliveCheck OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "PD alive check (CLI 'poe alive check enable|disable', shown as
         'POE PD check status'). Mapping verified by changing the setting
         via CLI and observing this column. Reconstructed from data
         returned by ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS
         5.2.1); Raisecom publishes no MIB for this object."
    ::= { raisecomPoePortEntry 10 }

raisecomPoePortAliveAction OBJECT-TYPE
    SYNTAX      INTEGER { none(0), reboot(1), rebootAlarm(2), alarm(3) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Action when the PD alive check fails (CLI 'poe alive action
         reboot|reboot-alarm|alarm', 'no poe alive action' gives none;
         shown as 'POE PD fail action', N/A for none). Mapping verified
         by changing the setting via CLI and observing this column.
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPoePortEntry 11 }

raisecomPoePortRebootInterval OBJECT-TYPE
    SYNTAX      Integer32 (0..2147483647)
    UNITS       "seconds"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Power-off time when rebooting a failed PD (CLI 'poe reboot
         interval', shown as 'POE PD fail reboot interval'). Mapping
         verified by changing the setting via CLI and observing this
         column. Reconstructed from data returned by ISCOM2624G-4GE-PWR-
         AC, software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPoePortEntry 12 }

raisecomPoePortLinktraceTrack OBJECT-TYPE
    SYNTAX      Integer32 (0..128)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Track object the port follows, 0 for none (CLI 'poe linktrace
         track <1-128>', 'no poe linktrace' gives 0; shown as 'POE PD
         linktrace'). Mapping verified by changing the setting via CLI
         and observing this column. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomPoePortEntry 14 }

raisecomPoePortOperStatus OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Operational PoE state of the port (shown as 'POE operation
         status' / 'POE actual running status'; the two could not be told
         apart). Follows raisecomPoePortAdminStatus when PoE is disabled
         on the port. Reconstructed from data returned by ISCOM2624G-4GE-
         PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB
         for this object."
    ::= { raisecomPoePortEntry 15 }

raisecomPoePseTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF RaisecomPoePseEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Per-PSE PoE totals."
    ::= { raisecomPoeMIB 2 }

raisecomPoePseEntry OBJECT-TYPE
    SYNTAX      RaisecomPoePseEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "Totals of one PSE."
    INDEX       { raisecomPoePseGroupIndex }
    ::= { raisecomPoePseTable 1 }

RaisecomPoePseEntry ::= SEQUENCE {
    raisecomPoePseAveragePower           Gauge32,
    raisecomPoePsePeakPower              Gauge32,
    raisecomPoePseLegacyDetection        EnableVar,
    raisecomPoePseTemperatureProtection  EnableVar,
    raisecomPoePsePower                  Gauge32,
    raisecomPoePseGroupIndex             Integer32
}

raisecomPoePseGroupIndex OBJECT-TYPE
    SYNTAX      Integer32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "PSE group, always 1 on single-PSE switches. Matches
         pethMainPseGroupIndex."
    ::= { raisecomPoePseEntry 100 }

raisecomPoePseAveragePower OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Total power delivered, averaged by the switch ('Average
         Power(mW)' in CLI 'show poe pse'). The instantaneous total in
         whole watts is pethMainPseConsumptionPower ('Output Power(W)').
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPoePseEntry 1 }

raisecomPoePsePeakPower OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "milliwatts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Highest total power delivered ('Peak Power(mW)' in CLI).
         Reconstructed from data returned by ISCOM2624G-4GE-PWR-AC,
         software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB for
         this object."
    ::= { raisecomPoePseEntry 2 }

raisecomPoePsePower OBJECT-TYPE
    SYNTAX      Gauge32
    UNITS       "watts"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Power budget of the PSE ('Wattage Rating(W)' in CLI,
         pethMainPsePower). Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomPoePseEntry 8 }

raisecomPoePseLegacyDetection OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Detection of legacy (pre-802.3af) powered devices (CLI 'poe
         legacy enable|disable', shown as 'PSE legacy detection').
         Mapping verified by changing the setting via CLI and observing
         this column. Reconstructed from data returned by ISCOM2624G-4GE-
         PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom publishes no MIB
         for this object."
    ::= { raisecomPoePseEntry 3 }

raisecomPoePseTemperatureProtection OBJECT-TYPE
    SYNTAX      EnableVar
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Over-temperature protection of the PSE (CLI 'poe temperature-
         protection enable|disable', shown as 'Switch temperature-
         protection'). Mapping verified by changing the setting via CLI
         and observing this column. Reconstructed from data returned by
         ISCOM2624G-4GE-PWR-AC, software 3.60.311 (ROS 5.2.1); Raisecom
         publishes no MIB for this object."
    ::= { raisecomPoePseEntry 5 }

END
