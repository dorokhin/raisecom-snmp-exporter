# HELP raisecom_poe_pse_temperature_protection 1 when PSE over-temperature protection is enabled.
# TYPE raisecom_poe_pse_temperature_protection gauge
raisecom_poe_pse_temperature_protection 1
# HELP raisecom_poe_usage_threshold_ratio Usage ratio at which the PSE raises an alarm.
# TYPE raisecom_poe_usage_threshold_ratio gauge
raisecom_poe_usage_threshold_ratio 1
