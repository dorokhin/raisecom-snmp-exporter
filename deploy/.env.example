# Copy to .env and adjust. Every variable is optional: docker-compose.yml has the same defaults.

# Exporter image tag on Docker Hub (andrewpinkerton/raisecom-snmp-exporter), e.g. 1.0.0.
RAISECOM_EXPORTER_TAG=latest
EXPORTER_LOG_LEVEL=info

# SNMP credentials, referenced from raisecom/config.yml.
SNMP_COMMUNITY=public
# Only for the SNMPv3 auth in raisecom/config.yml (commented out there by default).
SNMP_AUTH_PASSWORD=
SNMP_PRIV_PASSWORD=

# Grafana administrator. Change the password before exposing Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Published ports.
EXPORTER_PORT=9840
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# How long Prometheus keeps data.
PROMETHEUS_RETENTION=30d

# Time zone for Grafana.
TZ=UTC
